rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSchoolIdentity() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@smpialwasi-maros\\.sch\\.id$')
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }

    function userProfileExists() {
      return isSchoolIdentity()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return userProfileExists()
        && userRole() == 'super_admin'
        && request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id';
    }

    function isGuruOrAdmin() {
      return userProfileExists()
        && userRole() in ['super_admin', 'guru', 'kepala_sekolah', 'operator', 'wali_kelas', 'guru_bk'];
    }

    function isStudent() {
      return signedIn()
        && request.auth.token.role == 'student'
        && request.auth.token.studentId is string
        && request.auth.token.classLevel in ['VII', 'VIII', 'IX'];
    }

    function validProfile(userId) {
      return isSchoolIdentity()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'nip', 'assignedClass', 'subject', 'phone', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 50))
        && request.resource.data.role == (
          request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id' ? 'super_admin' : 'guru'
        );
    }

    function validStudentRegistration(studentId) {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && studentId.size() == 68
        && studentId.matches('^std-[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly([
          'id', 'nis', 'nisn', 'name', 'gender', 'className',
          'status', 'registeredAt', 'registrationSource'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'nis', 'nisn', 'name', 'gender', 'className',
          'status', 'registeredAt', 'registrationSource'
        ])
        && request.resource.data.id == studentId
        && request.resource.data.nis is string
        && request.resource.data.nis.size() <= 30
        && request.resource.data.nisn is string
        && request.resource.data.nisn.size() > 0
        && request.resource.data.nisn.size() <= 30
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['L', 'P']
        && request.resource.data.className in ['VII (Tujuh)', 'VIII (Delapan)', 'IX (Sembilan)']
        && request.resource.data.status == 'menunggu'
        && request.resource.data.registeredAt is string
        && request.resource.data.registeredAt.size() <= 50
        && request.resource.data.registrationSource == 'public_form'
        && !exists(/databases/$(database)/documents/students/$(studentId));
    }


    match /users/{userId} {
      allow get: if isSchoolIdentity()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Akun hanya dapat membuat profil dirinya dengan peran awal yang ditentukan server-side.
      allow create: if validProfile(userId);

      // Pengguna tidak dapat mengubah perannya sendiri. Perubahan peran hanya oleh admin.
      allow update: if isAdmin()
        || (validProfile(userId)
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /studentExamDirectory/{studentId} {
      // Tamu hanya boleh membaca daftar identitas minimum; seluruh penulisan khusus admin.
      allow get, list: if isAdmin()
        || isGuruOrAdmin()
        || (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous');
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name', 'className', 'status'])
        && request.resource.data.keys().hasAll(['id', 'name', 'className', 'status'])
        && request.resource.data.id == studentId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.className is string
        && request.resource.data.className.matches('^(VII|VIII|IX)(-[A-Z0-9]+| \\(Tujuh\\)| \\(Delapan\\)| \\(Sembilan\\))?$')
        && request.resource.data.status == 'Aktif';
      allow delete: if isAdmin();
    }

    match /studentLoginLookup/{lookupId} {
      // Login hanya mengambil satu dokumen berdasarkan hash NISN; daftar tidak terbuka untuk umum.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['studentId', 'nisn'])
        && request.resource.data.keys().hasAll(['studentId', 'nisn'])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.studentId.size() <= 128
        && request.resource.data.nisn is string
        && request.resource.data.nisn.size() > 0
        && request.resource.data.nisn.size() <= 30;
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Siswa hanya boleh membaca dokumen miliknya berdasarkan klaim token server.
      allow get: if isGuruOrAdmin()
        || (signedIn() && request.auth.token.role == 'student' && request.auth.token.studentId == studentId);
      allow list: if isGuruOrAdmin();
      // Impor Excel memakai setDoc(..., {merge:true}); admin perlu create dan update.
      allow create: if isAdmin() || validStudentRegistration(studentId);
      allow update, delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /attendance_history/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /journals/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /behaviors/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /counseling/{id} {
      allow read, write: if isAdmin()
        || (userProfileExists() && userRole() == 'guru_bk');
    }
    match /assessments/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /settings/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /teachers/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /master_classes/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /master_subjects/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /extracurriculars/{id} {
      allow read, write: if isGuruOrAdmin();
    }

    match /examQuestions/{questionId} {
      allow read, write: if isAdmin();
    }

    match /examPublicQuestions/{questionId} {
      // Koleksi ini khusus konten soal publik; kunci jawaban harus disimpan terpisah.
      allow read: if isGuruOrAdmin()
        || (((signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous') || isStudent())
          && resource.data.keys().hasOnly([
            'title', 'subject', 'className', 'academicYear', 'semester',
            'prompt', 'options', 'points', 'createdAt'
          ])
          && (!isStudent() || resource.data.className == request.auth.token.className));
      allow create, update: if isGuruOrAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'subject', 'className', 'academicYear', 'semester',
          'prompt', 'options', 'points', 'createdAt'
        ]);
      allow delete: if isGuruOrAdmin();
    }

    match /examAnswerKeys/{questionId} {
      // Kunci dapat dibaca oleh sesi siswa anonim untuk pemeriksaan lokal saat ujian.
      // Ini berarti kunci tidak dapat dijamin rahasia dari siswa yang membongkar data aplikasi.
      allow read: if isGuruOrAdmin()
        || (signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous')
        || (isStudent()
          && exists(/databases/$(database)/documents/examPublicQuestions/$(questionId))
          && get(/databases/$(database)/documents/examPublicQuestions/$(questionId)).data.className == request.auth.token.className);
      allow create, update, delete: if isGuruOrAdmin();
    }

        match /googleFormExamParticipants/{controlId} {
      allow get: if isGuruOrAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || (isStudent() && resource.data.studentId == request.auth.token.studentId)));
      allow list: if isGuruOrAdmin();
      allow create: if isGuruOrAdmin()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.blocked == false
          && request.resource.data.resetVersion == 0
          && request.resource.data.keys().hasOnly(['examId', 'studentId', 'ownerUid', 'blocked', 'resetVersion', 'updatedAt'])
          && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || (isStudent() && request.resource.data.studentId == request.auth.token.studentId)));
      allow update: if isGuruOrAdmin()
        || (signedIn()
          && (!('ownerUid' in resource.data) || resource.data.ownerUid == null || resource.data.ownerUid == request.auth.uid)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
          && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || (isStudent() && resource.data.studentId == request.auth.token.studentId)))
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt'])
          && (request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp)
          && (request.auth.token.firebase.sign_in_provider == 'anonymous'
            || (isStudent() && resource.data.studentId == request.auth.token.studentId)));
      allow delete: if isAdmin();
    }

    match /googleFormExams/{examId} {
      allow read: if isGuruOrAdmin()
        || (isStudent()
          && resource.data.status == 'Aktif'
          && resource.data.classLevel == request.auth.token.classLevel)
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.status == 'Aktif'
          && resource.data.classLevel in ['VII', 'VIII', 'IX']);
      allow create: if isGuruOrAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'examType', 'subject', 'className', 'classLevel', 'formId', 'formUrl',
          'enableSchedule', 'startAt', 'endAt', 'enableCountdown', 'duration',
          'enablePenalty', 'penaltyMinutes', 'status', 'createdAt', 'createdBy',
          'teacherName', 'updatedAt', 'updatedBy'
        ])
        && (!('examType' in request.resource.data) || request.resource.data.examType is string)
        && (!('enableSchedule' in request.resource.data) || request.resource.data.enableSchedule is bool)
        && (!('enableCountdown' in request.resource.data) || request.resource.data.enableCountdown is bool)
        && (!('enablePenalty' in request.resource.data) || request.resource.data.enablePenalty is bool)
        && (!('penaltyMinutes' in request.resource.data) || (request.resource.data.penaltyMinutes is number && request.resource.data.penaltyMinutes >= 1 && request.resource.data.penaltyMinutes <= 30))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.subject is string
        && request.resource.data.className is string
        && request.resource.data.classLevel in ['VII', 'VIII', 'IX']
        && request.resource.data.formId is string
        && request.resource.data.formId.size() > 10
        && request.resource.data.formId.size() <= 200
        && request.resource.data.formUrl is string
        && request.resource.data.formUrl.matches('^https://(docs\\.google\\.com/forms/.*|forms\\.google\\.com/forms/.*|forms\\.gle/.*)')
        && request.resource.data.duration is number
        && request.resource.data.duration >= 1
        && request.resource.data.duration <= 300
        && request.resource.data.status in ['Draft', 'Aktif'];
      allow update: if isGuruOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'examType', 'subject', 'className', 'classLevel', 'formId', 'formUrl',
          'enableSchedule', 'startAt', 'endAt', 'enableCountdown', 'duration',
          'enablePenalty', 'penaltyMinutes', 'status', 'updatedAt', 'updatedBy'
        ])
        && (!('examType' in request.resource.data) || request.resource.data.examType is string)
        && (!('enableSchedule' in request.resource.data) || request.resource.data.enableSchedule is bool)
        && (!('enableCountdown' in request.resource.data) || request.resource.data.enableCountdown is bool)
        && (!('enablePenalty' in request.resource.data) || request.resource.data.enablePenalty is bool)
        && (!('penaltyMinutes' in request.resource.data) || (request.resource.data.penaltyMinutes is number && request.resource.data.penaltyMinutes >= 1 && request.resource.data.penaltyMinutes <= 30))
        && request.resource.data.title is string
        && request.resource.data.formId is string
        && request.resource.data.formUrl is string
        && request.resource.data.status in ['Draft', 'Aktif', 'Arsip'];
      allow delete: if isAdmin();
    }

    match /googleFormResults/{resultId} {
      allow read: if isGuruOrAdmin();
      allow write: if false;
    }

    match /exams/{examId} {
      allow read: if isGuruOrAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.status == 'Aktif')
        || (isStudent()
          && resource.data.status == 'Aktif'
          && resource.data.className == request.auth.token.className);
      allow create, update, delete: if isGuruOrAdmin();
    }

    match /examStudentCodes/{code} {
      allow get: if isAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.active == true
          && (!('ownerUid' in resource.data) || resource.data.ownerUid == null || resource.data.ownerUid == request.auth.uid));
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.active == true
          && (!('ownerUid' in resource.data) || resource.data.ownerUid == null)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']));
    }

    match /examAttempts/{attemptId} {
      allow read: if isGuruOrAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.ownerUid == request.auth.uid)
        || (isStudent()
          && resource.data.studentId == request.auth.token.studentId);

      allow create: if signedIn()
        && (request.auth.token.firebase.sign_in_provider == 'anonymous' || isStudent())
        && request.resource.data.keys().hasOnly([
          'examId', 'examTitle', 'studentId', 'studentName', 'className',
          'answers', 'ownerUid', 'status', 'startedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.examId.size() <= 128
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 128
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 100
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 30
        && request.resource.data.answers is map
        && request.resource.data.status == 'Mengerjakan'
        && request.resource.data.startedAt is string
        && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status == 'Aktif'
        && (!isStudent() || (
          request.resource.data.studentId == request.auth.token.studentId
          && request.resource.data.className == request.auth.token.className
          && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.className == request.auth.token.className
        ));

      allow update: if isGuruOrAdmin()
        || (signedIn()
          && (request.auth.token.firebase.sign_in_provider == 'anonymous' || isStudent())
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && (!isStudent() || resource.data.studentId == request.auth.token.studentId)
          && resource.data.status == 'Mengerjakan'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'status', 'submittedAt', 'autoSubmitted', 'lastSavedAt',
            'score', 'total', 'percent', 'gradingIssue', 'gradedAt'
          ])
          && request.resource.data.answers is map
          && request.resource.data.status in ['Mengerjakan', 'Selesai']
          && (!('submittedAt' in request.resource.data)
            || request.resource.data.submittedAt is string)
          && (!('autoSubmitted' in request.resource.data)
            || request.resource.data.autoSubmitted is bool)
          && (!('lastSavedAt' in request.resource.data)
            || request.resource.data.lastSavedAt is string)
          && (!('score' in request.resource.data) || request.resource.data.score is number)
          && (!('total' in request.resource.data) || request.resource.data.total is number)
          && (!('percent' in request.resource.data) || request.resource.data.percent is number)
          && (!('gradingIssue' in request.resource.data) || request.resource.data.gradingIssue is string)
          && (!('gradedAt' in request.resource.data) || request.resource.data.gradedAt is string));
      allow delete: if isAdmin();
    }

    // Default deny: semua koleksi/dokumen lain tertutup kecuali diizinkan eksplisit di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
